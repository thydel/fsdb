+- id: files-type
+  perl: |
+    BEGIN {
+      $j = JSON::PP->new->utf8;
+      $magic = File::LibMagic->new(follow_symlinks => 1, uncompress => 0);
+      $| = 1;
+    }
+    chomp;
+    my $filename = $_;
+    
+    eval {
+      my $info = $magic->info_from_filename($filename);
+      if ($info) {
+        print $j->encode([$filename, $info->{mime_type}, $info->{encoding}]), "\n";
+      } else {
+        print $j->encode([$filename, undef, undef]), "\n";
+      }
+    };
+    
+    # Check if the eval block died
+    if ($@) {
+      my $err = "$@"; # Capture the error message
+      chomp $err;
+      $err =~ s/ at \/usr\/lib.*//; # Clean up error string
+      $err =~ s/, <> chunk \d+.//;
+      
+      # Print a log message to STDERR for visibility
+      print STDERR "Caught fatal error for '$filename': $err\n";
+      
+      # Print an ERROR record to STDOUT to continue the stream
+      print $j->encode([$filename, "ERROR", $err]), "\n";
+    }
+  sh: |
+    (cd ${1:?} && find . -type f -print0 | perl -MJSON::PP -MFile::LibMagic -0 -ne "$perl")
+  tt: |
+    files-type /usr/share
+    files-type ssp.upload
 
